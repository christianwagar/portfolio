---
import { site } from "../data/site";
---

<section id="consulting" class="section consulting-section">
  <div class="container consulting-inner">
    <div class="consulting-content">
      <span class="section-label">Consulting</span>
      <h2 class="section-title">{site.consulting.headline}</h2>
      <ul class="consulting-list">
        {site.consulting.bullets.map((bullet) => (
          <li>{bullet}</li>
        ))}
      </ul>
      <a href={site.linkedin} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
        {site.cta} on LinkedIn
      </a>
    </div>
    <div class="consulting-aside">
      <div class="consulting-card">
        <h3>Who I help</h3>
        <p>CS leaders, VPs of Customer Experience, and GTM executives building or scaling Customer Success organizations — especially teams navigating AI adoption.</p>
      </div>
      <div class="consulting-card">
        <h3>How I work</h3>
        <p>Intro conversation → scoped engagement → hands-on advisory. Formats include strategic reviews, team coaching, and operational build-outs.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .consulting-section {
    background:
      radial-gradient(ellipse 60% 50% at 0% 50%, rgba(249, 115, 22, 0.06), transparent),
      var(--bg);
  }

  .consulting-inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .consulting-list {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
  }

  .consulting-list li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.875rem;
    color: var(--text-muted);
    font-size: 1rem;
  }

  .consulting-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .consulting-aside {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .consulting-card {
    padding: 1.25rem 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .consulting-card h3 {
    font-size: 0.9375rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
  }

  .consulting-card p {
    color: var(--text-muted);
    font-size: 0.9375rem;
    margin: 0;
  }

  @media (max-width: 768px) {
    .consulting-inner {
      grid-template-columns: 1fr;
    }
  }
</style>
