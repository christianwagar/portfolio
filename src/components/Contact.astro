---
import { site } from "../data/site";
---

<section id="contact" class="section contact-section">
  <div class="container contact-inner">
    <span class="section-label">Contact</span>
    <h2 class="section-title">Talk Shop</h2>
    <p class="contact-intro">
      Product or process strategy, leadership, AI, a potential consulting fit, or you just want to say something here landed, I'm in.
    </p>
    <a href={site.linkedin} class="cta" target="_blank" rel="noopener noreferrer">
      Say Whats Up
    </a>
  </div>
</section>

<style>
  .contact-section {
    text-align: center;
    padding-bottom: 6rem;
    background: var(--bg);
  }

  .contact-inner {
    max-width: 36rem;
    margin-inline: auto;
  }

  .contact-intro {
    color: var(--text-muted);
    font-size: 1.0625rem;
    margin: 0 auto 2rem;
    line-height: 1.7;
  }
</style>
