---
import { site } from "../data/site";
import GoldCylinder from "./GoldCylinder.astro";
---

<section id="contact" class="section contact-section">
  <div class="container contact-inner">
    <span class="section-label"><GoldCylinder size="sm" /> Contact</span>
    <h2 class="section-title">Let's connect</h2>
    <p class="contact-intro">
      Open to conversations about the future of Customer Success, leadership, AI-augmented teams, and consulting engagements.
    </p>
    <a
      href={site.linkedin}
      class="btn btn-primary contact-btn"
      target="_blank"
      rel="noopener noreferrer"
    >
      {site.cta} on LinkedIn
    </a>
  </div>
</section>

<style>
  .contact-section {
    text-align: center;
    padding-bottom: 6rem;
  }

  .contact-inner {
    max-width: 560px;
  }

  .contact-inner .section-label {
    justify-content: center;
  }

  .contact-intro {
    color: var(--text-muted);
    font-size: 1.0625rem;
    margin: 0 auto 2rem;
  }

  .contact-btn {
    font-size: 1rem;
    padding: 0.875rem 2rem;
  }
</style>
