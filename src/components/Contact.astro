---
import { site } from "../data/site";
---

<section id="contact" class="section contact-section">
  <div class="container contact-inner">
    <span class="section-label">Contact</span>
    <h2 class="section-title">Let's connect</h2>
    <p class="contact-intro">
      Open to conversations about the future of Customer Success, leadership, AI-augmented teams,
      and consulting engagements.
    </p>
    <a href={site.linkedin} class="cta" target="_blank" rel="noopener noreferrer">
      Let's Connect
    </a>
  </div>
</section>

<style>
  .contact-section {
    text-align: center;
    padding-bottom: 6rem;
    background: var(--bg);
  }

  .contact-inner {
    max-width: 36rem;
    margin-inline: auto;
  }

  .contact-intro {
    color: var(--text-muted);
    font-size: 1.0625rem;
    margin: 0 auto 2rem;
    line-height: 1.7;
  }
</style>
