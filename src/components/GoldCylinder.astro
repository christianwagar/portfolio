---
/* Reusable dripping-gold cylinder marker from reference textures */
interface Props {
  size?: "sm" | "md";
  alt?: boolean;
}

const { size = "md", alt = false } = Astro.props;
const classes = ["gold-cylinder", size === "sm" && "gold-cylinder--sm", alt && "gold-cylinder--alt"]
  .filter(Boolean)
  .join(" ");
---

<span class={classes} aria-hidden="true"></span>
