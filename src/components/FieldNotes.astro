---
import { fieldNotes } from "../data/site";
---

<section id="notes" class="section notes-section">
  <div class="container">
    <span class="section-label">Field notes</span>
    <h2 class="section-title">What I'm tinkering with</h2>
    <div class="grid-3 notes-grid">
      {
        fieldNotes.map((note) => (
          <article class="note-item">
            <p class="note-status">{note.status}</p>
            <h3>{note.title}</h3>
            <p class="note-teaser">{note.teaser}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .notes-section {
    background: var(--bg);
  }

  .note-item {
    display: flex;
    flex-direction: column;
    padding-top: 0.25rem;
    border-top: 1px solid var(--border);
  }

  .note-status {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 1.125rem 0 0.375rem;
  }

  .note-item h3 {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0 0 0.625rem;
    line-height: 1.2;
  }

  .note-teaser {
    color: var(--text-muted);
    font-size: 0.9375rem;
    margin: 0;
    line-height: 1.6;
  }
</style>
