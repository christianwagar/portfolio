---
import { getCollection } from "astro:content";

const notes = (await getCollection("notes")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section id="notes" class="section notes-section">
  <div class="container">
    <span class="section-label">Field notes</span>
    <h2 class="section-title">What I'm tinkering with</h2>
    <p class="section-intro">
      Stay tuned, y'all. I'm quite literally writing these right now. The tiles below are the half-baked ideas on the whiteboard, teasers until the long versions are ready.
    </p>
    <div class="grid-3 notes-grid">
      {
        notes.map((note) => (
          <a href={`/notes/${note.id}`} class="note-item">
            <div class="note-thumb">
              {note.data.image ? (
                <img
                  src={note.data.image}
                  alt={note.data.imageAlt ?? note.data.title}
                  loading="lazy"
                />
              ) : null}
            </div>
            <h3>{note.data.title}</h3>
            <p class="note-teaser">{note.data.teaser}</p>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .notes-section {
    background: var(--bg);
  }

  .note-item {
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }

  .note-item:hover {
    opacity: 1;
  }

  .note-item:hover .note-thumb img {
    transform: scale(1.03);
  }

  .note-thumb {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--bg-soft);
    margin-bottom: 1rem;
  }

  .note-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .note-item h3 {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0 0 0.625rem;
    line-height: 1.2;
  }

  .note-teaser {
    color: var(--text-muted);
    font-size: 0.9375rem;
    margin: 0;
    line-height: 1.6;
  }
</style>
