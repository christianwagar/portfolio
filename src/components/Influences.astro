---
import { getCollection } from "astro:content";
import { influences } from "../data/site";

const reviews = await getCollection("books");
const reviewIds = new Set(reviews.map((review) => review.id));
---

<section id="influences" class="section influences-section">
  <div class="container">
    <span class="section-label">Influences</span>
    <h2 class="section-title">The Shelf</h2>
    <p class="influences-intro">
      Books I've read, reading, and still need to figure out. Podcasts that I think are solid as well as a few things in between.
    </p>

    <div class="influence-shelf">
      <h3 class="shelf-label">Books</h3>
      <div class="grid-3">
        {
          influences.books.map((book) => {
            const href = book.slug && reviewIds.has(book.slug) ? `/books/${book.slug}` : null;
            const card = (
              <>
                {book.image && (
                  <div class="influence-thumb">
                    <img src={book.image} alt={book.imageAlt ?? book.title} loading="lazy" />
                  </div>
                )}
                <p class="influence-status">{book.status}</p>
                <h4>{book.title}</h4>
                {book.author && <p class="influence-credit">{book.author}</p>}
                <p class="influence-note">{book.note}</p>
              </>
            );
            return href ? (
              <a href={href} class="influence-item">
                {card}
              </a>
            ) : (
              <article class="influence-item">{card}</article>
            );
          })
        }
      </div>
    </div>

    <div class="influence-shelf">
      <h3 class="shelf-label">Podcasts</h3>
      <div class="grid-3">
        {
          influences.podcasts.map((show) => (
            <article class="influence-item">
              <p class="influence-status">{show.status}</p>
              <h4>{show.title}</h4>
              <p class="influence-credit">{show.host}</p>
              <p class="influence-note">{show.note}</p>
              {show.link && (
                <a
                  href={show.link}
                  class="cta influence-cta"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Listen
                </a>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .influences-section {
    background: var(--bg);
  }

  .influences-intro {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.7;
    max-width: 42ch;
    margin: 0 0 2.75rem;
  }

  .influence-shelf {
    border-top: 1px solid var(--border);
    padding-top: 1.25rem;
  }

  .influence-shelf + .influence-shelf {
    margin-top: 3rem;
  }

  .shelf-label {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin: 0 0 1.5rem;
  }

  .influence-item {
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }

  a.influence-item:hover {
    opacity: 1;
  }

  a.influence-item:hover .influence-thumb img {
    transform: scale(1.03);
  }

  .influence-thumb {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--bg-soft);
    margin-bottom: 1rem;
  }

  .influence-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.5s ease;
  }

  .influence-status {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 0.375rem;
  }

  .influence-item h4 {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0 0 0.375rem;
    line-height: 1.2;
  }

  .influence-credit {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text);
    margin: 0 0 0.625rem;
  }

  .influence-note {
    color: var(--text-muted);
    font-size: 0.9375rem;
    margin: 0;
    line-height: 1.6;
  }

  .influence-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin-top: 0.875rem;
  }

  .influence-cta {
    margin-top: 0.875rem;
    align-self: flex-start;
  }
</style>
