---
import { site, awards } from "../data/site";
---

<section id="about" class="section">
  <div class="container about-grid">
    <div class="about-images">
      <img
        src="/images/personal-dog-1.jpg"
        alt="Christian Wagar with his dog"
        width="480"
        height="360"
        loading="lazy"
        class="about-dog"
      />
    </div>
    <div class="about-content">
      <span class="section-label">About</span>
      <h2 class="section-title">People, systems, and growth that lasts</h2>
      {site.about.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
      <div class="awards">
        <h3>Recognition</h3>
        <ul>
          {awards.map((award) => (
            <li>{award}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 3rem;
    align-items: start;
  }

  .about-dog {
    border-radius: var(--radius);
    border: 1px solid var(--border);
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .about-content p {
    color: var(--text-muted);
    margin: 0 0 1.125rem;
    font-size: 1.03125rem;
  }

  .awards {
    margin-top: 2rem;
    padding: 1.25rem 1.5rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .awards h3 {
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin: 0 0 0.75rem;
  }

  .awards ul {
    margin: 0;
    padding-left: 1.125rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  .awards li {
    margin-bottom: 0.375rem;
  }

  @media (max-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
