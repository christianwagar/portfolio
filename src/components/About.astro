---
import { site, awards } from "../data/site";
import GoldCylinder from "./GoldCylinder.astro";
---

<section id="about" class="section about-section">
  <div class="container about-grid">
    <div class="about-images">
      <img
        src="/images/personal-dog-1.jpg"
        alt="Christian Wagar with his dog"
        width="480"
        height="360"
        loading="lazy"
        class="about-dog"
      />
    </div>
    <div class="about-content">
      <span class="section-label"><GoldCylinder size="sm" /> About</span>
      <h2 class="section-title">People, systems, and growth that lasts</h2>
      {site.about.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
      <div class="awards">
        <h3><GoldCylinder size="sm" alt /> Recognition</h3>
        <ul>
          {awards.map((award) => (
            <li><GoldCylinder size="sm" /> {award}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    background: #000000;
    position: relative;
    z-index: 1;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 3rem;
    align-items: start;
  }

  .about-dog {
    border-radius: var(--radius);
    border: 1px solid var(--border-gold);
    box-shadow: var(--shadow-gold);
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .about-content p {
    color: var(--text-muted);
    margin: 0 0 1.125rem;
    font-size: 1.03125rem;
  }

  .awards {
    margin-top: 2rem;
    padding: 1.25rem 1.5rem;
    background: linear-gradient(160deg, rgba(8, 8, 8, 0.97), rgba(0, 0, 0, 0.99));
    border: 1px solid var(--border-gold);
    border-radius: var(--radius);
  }

  .awards h3 {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--gold-letter);
    margin: 0 0 0.75rem;
  }

  .awards ul {
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  .awards li {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    margin-bottom: 0.5rem;
  }

  @media (max-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
