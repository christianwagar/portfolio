---
import { site } from "../data/site";
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-content">
      <p class="hero-eyebrow">Available for consulting & advisory</p>
      <h1>{site.name}</h1>
      <p class="hero-tagline">{site.tagline}</p>
      <p class="hero-bio">{site.shortBio}</p>
      <div class="hero-actions">
        <a href={site.linkedin} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
          {site.cta}
        </a>
        <a href="#work" class="btn btn-outline">View my work</a>
      </div>
    </div>
    <div class="hero-image-wrap">
      <img
        src="/images/headshot.jpg"
        alt={`${site.name} — professional headshot`}
        width="420"
        height="520"
        loading="eager"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 4rem 0 5rem;
    background:
      radial-gradient(ellipse 80% 60% at 70% -10%, rgba(249, 115, 22, 0.08), transparent),
      var(--bg);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 3rem;
    align-items: center;
  }

  .hero-eyebrow {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0 0 1rem;
  }

  h1 {
    font-size: clamp(2.25rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 0 0 0.75rem;
  }

  .hero-tagline {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-muted);
    margin: 0 0 1.25rem;
  }

  .hero-bio {
    color: var(--text-muted);
    font-size: 1.0625rem;
    max-width: 52ch;
    margin: 0 0 2rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }

  .hero-image-wrap {
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    aspect-ratio: 4 / 5;
    background: var(--bg-card);
  }

  .hero-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-image-wrap {
      max-width: 320px;
      order: -1;
    }
  }
</style>
