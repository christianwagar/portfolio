---
import { site } from "../data/site";
---

<section class="hero">
  <div class="hero-media">
    <img
      src="/images/profile_picture_final.jpg"
      alt={`${site.name} — professional headshot`}
      width="1400"
      height="1400"
      loading="eager"
    />
  </div>
  <div class="hero-panel">
    <div class="hero-content reveal">
      <h1 class="hero-name">{site.name}</h1>
      <p class="hero-tagline">{site.tagline}</p>
      <div class="hero-actions">
        <a href={site.linkedin} class="cta" target="_blank" rel="noopener noreferrer">
          Let's Connect
        </a>
        <a href="#work" class="cta">View Work</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    min-height: calc(100vh - 3.75rem);
    min-height: calc(100dvh - 3.75rem);
    background: var(--bg);
  }

  .hero-media {
    position: relative;
    min-height: 420px;
    overflow: hidden;
    background: var(--bg-soft);
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
    position: absolute;
    inset: 0;
  }

  .hero-panel {
    display: flex;
    align-items: center;
    padding: 3.5rem 3.5rem 3.5rem 3rem;
  }

  .hero-content {
    max-width: 28rem;
  }

  .hero-name {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 6vw, 4.25rem);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 0.95;
    margin: 0 0 1.25rem;
  }

  .hero-tagline {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 2rem;
    color: var(--text);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 1.75rem;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .hero-media {
      min-height: 55vw;
      max-height: 480px;
      aspect-ratio: 4 / 5;
    }

    .hero-media img {
      position: relative;
      height: 100%;
    }

    .hero-panel {
      padding: 2.5rem 1.75rem 3.5rem;
    }
  }
</style>
