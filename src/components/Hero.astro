---
import { site } from "../data/site";
---

<section class="hero">
  <div class="hero-media">
    <img
      src="/images/profile_picture_final.jpg"
      alt={`${site.name} — professional headshot`}
      width="1400"
      height="1400"
      loading="eager"
    />
  </div>
  <div class="hero-panel">
    <div class="hero-content reveal">
      <h1 class="hero-name">{site.name}</h1>
      <div class="hero-opening">
        {site.opening.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        <p class="hero-signoff">{site.opening.signOff}</p>
        <img
          class="hero-signature"
          src="/signature-bold.png"
          alt=""
          width="862"
          height="383"
        />
      </div>
      <div class="hero-actions">
        <a href="#notes" class="cta">Field notes</a>
        <a href={site.linkedin} class="cta" target="_blank" rel="noopener noreferrer">
          Let's Connect
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    min-height: calc(100vh - 3.75rem);
    min-height: calc(100dvh - 3.75rem);
    background: var(--bg);
  }

  .hero-media {
    position: relative;
    min-height: 420px;
    overflow: hidden;
    background: var(--bg-soft);
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
    position: absolute;
    inset: 0;
  }

  .hero-panel {
    display: flex;
    align-items: center;
    padding: 3.5rem 3.5rem 3.5rem 3rem;
  }

  .hero-content {
    max-width: 38rem;
  }

  .hero-name {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5.5vw, 3.75rem);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 0.95;
    margin: 0 0 1.5rem;
  }

  .hero-opening {
    margin: 0;
  }

  .hero-opening p {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    line-height: 1.7;
    color: var(--text);
    margin: 0 0 1rem;
  }

  .hero-opening .hero-signoff {
    margin-top: 0.35rem;
    margin-bottom: 0;
  }

  .hero-signature {
    display: block;
    width: 11.25rem;
    height: auto;
    margin: 0.35rem 0 1.75rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 1.75rem;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .hero-media {
      min-height: 55vw;
      max-height: 480px;
      aspect-ratio: 4 / 5;
    }

    .hero-media img {
      position: relative;
      height: 100%;
    }

    .hero-panel {
      padding: 2.5rem 1.75rem 3.5rem;
    }
  }

  @media (max-height: 820px) and (min-width: 901px) {
    .hero {
      min-height: 0;
    }

    .hero-panel {
      align-items: flex-start;
      padding-top: 2.5rem;
      padding-bottom: 2.5rem;
    }
  }
</style>
