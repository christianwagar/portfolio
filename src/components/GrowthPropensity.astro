---
import GrowthQuadrantPreview from "./GrowthQuadrantPreview.astro";
import {
  FOCUS_RULE,
  SCORE_FIELDS,
  WEIGHTS,
  accountBrief,
  clusterGroups,
  focusAccounts,
  formatArr,
  formatNrr,
  formatScore,
  loadGrowthAccounts,
  sumArr,
  CLUSTERS,
  CLUSTER_META,
  DEMO_OVERRIDES,
  WATCH,
  type Cluster,
} from "../lib/growth-propensity";

const { accounts, source } = await loadGrowthAccounts();
const groups = clusterGroups(accounts);
const focus = focusAccounts(accounts);
const featured = focus[0]?.name ?? accounts[0]?.name ?? "";
const totalArr = sumArr(accounts);
const briefs = new Map(accounts.map((account) => [account.name, accountBrief(account)]));
const seedFor = (name: string) => DEMO_OVERRIDES.find((o) => o.account === name);
const slug = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, "-");
const sourceLabel = source === "Supabase" ? "Supabase" : "bundled JSON";
---

<div class="gp" id="growth-propensity">
  <section class="gp-block">
    <p class="gp-label">Method</p>
    <h2>Lower score, higher priority</h2>
    <p class="gp-prose">
      Each signal gets a band score from 1 to 8, like a stroke in golf. The strokes roll into five buckets, the buckets roll into one overall score, and the lowest total gets the team's attention first. Missing data scores an 8, so a blind spot does not get a free pass.
    </p>
    <p class="gp-prose">
      Clusters come from two questions: how likely is the account to grow, and how much does it spend? Growth potential is the A-GPS score with ARR taken out, so size never counts twice. Each axis is split at the median of the book, so the four groups rebalance every time the data changes and nobody ends up with everything in P1. Separately, a WATCH flag marks any account with NRR under 90 percent or a growth score worse than 6.0, wherever it lands.
    </p>
    <dl class="gp-weights">
      {
        WEIGHTS.map((bucket) => (
          <div>
            <dt>
              <span>{bucket.name}</span>
              <strong>{bucket.weight}</strong>
              <span class="gp-bar" aria-hidden="true">
                <span style={`width: ${bucket.width}%`} />
              </span>
            </dt>
            <dd>{bucket.fields}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <div class="gp-row gp-r1">
    <div class="gp-r1-left">
      <p class="gp-disclaimer">
        <strong>Demo data</strong>
        Brand names are labels only, and all metrics are invented. Apple, Bose, Coca-Cola, PlayStation, Nike, and the other names are not customers. None of these numbers describe the real companies.
      </p>
      <div class="gp-quads" role="list">
        {
          ["P2", "P1", "P4", "P3"].map((c) => {
            const group = groups.find((g) => g.cluster === c)!;
            const row = (account: (typeof accounts)[number]) => (
              <li>
                <button type="button" class="gp-qitem" data-account={account.name} aria-current={account.name === featured ? "true" : undefined}>
                  <strong>{account.name}{account.watch && <span class="gq-wtag" title={account.watchReason}>Watch</span>}</strong>
                  <span>{formatScore(account.growth ?? account.overall)} growth · {formatArr(account.arr)}</span>
                  <em>↑ {account.indicator}</em>
                </button>
              </li>
            );
            return (
              <section class="gp-quad" role="listitem" aria-label={`${c} ${group.name}`}>
                <header>
                  <h3><span class={`gp-badge gp-${c}`}>{c}</span> {group.name}</h3>
                  <span class="gp-quad-n">{group.count}</span>
                </header>
                <p class="gp-quad-sub">{CLUSTER_META[c as Cluster].quad} · {formatArr(group.arr)} ARR</p>
                <ol>{group.rows.slice(0, 3).map(row)}</ol>
                {group.rows.length > 3 && (
                  <details class="gp-quad-more">
                    <summary>+ {group.rows.length - 3} more{group.rows.slice(3).some((r) => r.watch) ? ` · ${group.rows.slice(3).filter((r) => r.watch).length} watch` : ""}</summary>
                    <ol>{group.rows.slice(3).map(row)}</ol>
                  </details>
                )}
              </section>
            );
          })
        }
      </div>
    </div>
    <div class="gp-r1-right">
      <div class="gp-r1-chart"><GrowthQuadrantPreview /></div>
        <div class="gp-how">
          <p><strong>How to read it:</strong> up and to the right is where to expand. Hover, tap, or tab to a dot for the account card; click it to open the account below. Dot shade is the cluster, P1 darkest.</p>
          <p><svg class="gp-key" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="5" fill="#fff" stroke="#000" /><circle cx="12" cy="12" r="9.5" fill="none" stroke="#000" stroke-dasharray="2 2" /></svg> <span class="gq-wtag">Watch</span> Health guardrail, separate from the median split: NRR under {WATCH.nrrBelow}% or growth score worse than {WATCH.growthWorseThan.toFixed(1)}. Both thresholds are configurable.</p>
        </div>
    </div>
  </div>

  <div class="gp-row gp-r2">
    <section class="gp-focus gp-card" aria-labelledby="gp-focus-heading">
      <p class="gp-label">This week</p>
      <h2 id="gp-focus-heading">Recommended accounts to focus on this week</h2>
      <ol class="gp-focus-list">
        {
          focus.map((account) => (
            <li>
              <button
                type="button"
                class="gp-focus-btn"
                data-account={account.name}
                aria-current={account.name === featured ? "true" : undefined}
              >
                <span class={`gp-badge gp-${account.cluster}`}>{account.cluster}</span>
                <span class="gp-focus-name">{account.name}</span>
                <span class="gp-focus-meta">
                  {formatScore(account.growth ?? account.overall)} growth
                  <span class="gp-dot-sep" aria-hidden="true">·</span>
                  {Math.round(account.renewal)} days to renewal
                  <span class="gp-dot-sep" aria-hidden="true">·</span>
                  {formatArr(account.arr)} ARR
                </span>
              </button>
            </li>
          ))
        }
      </ol>
      <p class="gp-rule">{FOCUS_RULE}</p>
    </section>

  <section class="gp-detail" id="gp-detail" aria-labelledby="gp-detail-label">
    <p class="gp-label" id="gp-detail-label">Account</p>
    {
      accounts.map((account) => {
        const brief = briefs.get(account.name);
        return (
          <article data-detail={account.name} hidden={account.name !== featured}>
            <div class="gp-detail-top">
              <div>
                <h2 class="gp-detail-name" tabindex="-1">{account.name}</h2>
                <p class="gp-detail-arr">{formatArr(account.arr)}</p>
                <p class="gp-detail-meta">
                  <span class={`gp-badge gp-${account.cluster}`}>{account.cluster}</span>
                  <span>Growth {formatScore(account.growth ?? account.overall)}</span>
                  <span>Overall {formatScore(account.overall)}</span>
                  {account.watch && <span class="gq-wtag-inline" title={account.watchReason}>Watch · {account.watchReason}</span>}
                  <span>{formatNrr(account.nrr)} NRR</span>
                  <span>{Math.round(account.renewal)} days to renewal</span>
                </p>
              </div>
              <div class="gp-blurbs">
                <section>
                  <h3>Why {account.cluster}</h3>
                  <p>{brief?.why}</p>
                </section>
                <section>
                  <h3>Recommended plan</h3>
                  <p>{brief?.plan}</p>
                </section>
                <section>
                  <h3>What to watch out for</h3>
                  <p>{brief?.watch}</p>
                </section>
                <p class="gp-auto">Auto-generated from scores; AI summary coming</p>
              </div>
            </div>
            <ol class="gp-scores">
              {SCORE_FIELDS.map((field) => (
                <li>
                  <span class="gp-score-label">{field.label}</span>
                  <span class="gp-score-num">{formatScore(account[field.key])}</span>
                  <span class="gp-score-weight">{field.weight} weight</span>
                </li>
              ))}
            </ol>
          </article>
        );
      })
    }
  </section>

  </div>

  <div class="gp-row gp-r3">
  <section class="gp-tablebox" aria-labelledby="gp-table-heading">
    <p class="gp-label">Accounts</p>
    <h2 id="gp-table-heading">All accounts</h2>
    <p class="gp-prose">
      The full book, best growth score first. Filter by cluster, search by name, or select a column to sort. Select a name to open the account detail.
    </p>
    <div class="gp-controls">
      <div class="gp-filters" role="group" aria-label="Filter by cluster">
        {
          ["All", "P1", "P2", "P3", "P4"].map((filter) => (
            <button
              type="button"
              class="gp-chip"
              data-filter={filter}
              aria-pressed={filter === "All" ? "true" : "false"}
            >
              {filter}
            </button>
          ))
        }
      </div>
      <input class="gp-search" type="search" placeholder="Search accounts" aria-label="Search accounts" />
    </div>
    <p class="gp-scroll-hint">Bucket scores are hidden on small screens. Open an account to see them.</p>
    <div class="gp-table-wrap" tabindex="0" role="region" aria-label="Account scores">
      <table class="gp-table">
        <thead>
          <tr>
            <th scope="col" data-k="name" aria-sort="none">
              <button type="button">Account</button>
            </th>
            <th scope="col" data-k="arr" aria-sort="none">
              <button type="button">ARR</button>
            </th>
            <th scope="col" data-k="nrr" aria-sort="none">
              <button type="button">NRR</button>
            </th>
            <th scope="col" data-k="renewal" aria-sort="none">
              <button type="button" title="Days to renewal">Renewal</button>
            </th>
            {
              SCORE_FIELDS.map((field) => (
                <th scope="col" class="gp-lo" data-k={field.key} aria-sort="none" title={field.label}>
                  <button type="button">{field.short}</button>
                </th>
              ))
            }
            <th scope="col" data-k="overall" aria-sort="ascending">
              <button type="button">Growth</button>
            </th>
            <th scope="col" class="gp-c" data-k="cluster" aria-sort="none">
              <button type="button">Cluster</button>
            </th>
            <th scope="col" class="gp-ov-head" title="Account overrides, last 90 days">Override<br /><span>90 days</span></th>
          </tr>
        </thead>
        <tbody>
          {
            accounts.map((account) => (
              <tr
                data-name={account.name}
                data-cluster={account.cluster}
                data-arr={account.arr}
                data-nrr={account.nrr}
                data-renewal={account.renewal}
                data-gtm={account.gtm}
                data-mkt={account.mkt}
                data-post={account.post}
                data-prod={account.prod}
                data-dd={account.dd}
                data-overall={account.growth ?? account.overall}
              >
                <td>
                  <button
                    type="button"
                    class="gp-name-btn"
                    data-account={account.name}
                    aria-current={account.name === featured ? "true" : undefined}
                  >
                    {account.name}
                  </button>
                </td>
                <td>{formatArr(account.arr)}</td>
                <td>{formatNrr(account.nrr)}</td>
                <td>{Math.round(account.renewal)}</td>
                {SCORE_FIELDS.map((field) => (
                  <td class="gp-lo">{formatScore(account[field.key])}</td>
                ))}
                <td class="gp-overall">{formatScore(account.growth ?? account.overall)}</td>
                <td class="gp-c">
                  <span class={`gp-badge gp-${account.cluster}`}>{account.cluster}</span>
                </td>
                <td class="gp-ov-cell" data-ov-cell={account.name}>
                  {seedFor(account.name) && (
                    <button type="button" class={`gp-ov gp-badge gp-${seedFor(account.name)!.cluster}`} aria-describedby={`ov-${slug(account.name)}`}>
                      {seedFor(account.name)!.cluster}
                      <span class="gp-ov-tip" role="tooltip" id={`ov-${slug(account.name)}`}>
                        <b>{seedFor(account.name)!.date} · Overridden to {seedFor(account.name)!.cluster} <i>Demo</i></b>
                        <span>Reason: {seedFor(account.name)!.reason}</span>
                        <span>{seedFor(account.name)!.note}</span>
                      </span>
                    </button>
                  )}
                </td>
              </tr>
            ))
          }
          <tr class="gp-empty" hidden>
            <td colspan="12">No accounts match.</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="gp-meta">
      Data source: {sourceLabel}. <span id="gp-shown">{accounts.length}</span> of {accounts.length} accounts. Best growth score first. Override chips marked Demo are invented examples.
    </p>
  </section>

    <section class="gp-ovpanel gp-card" aria-labelledby="gp-ov-heading" id="gp-ovpanel">
      <p class="gp-label">Demo</p>
      <h2 id="gp-ov-heading">Scoring override entry</h2>
      <p class="gp-ov-demo">Demo: entries stay in your browser. Nothing is sent or saved to a server.</p>
      <form class="gp-ovform">
        <label>Account
          <select name="account">{accounts.map((a) => <option value={a.name} selected={a.name === "Stripe"}>{a.name}</option>)}</select>
        </label>
        <label>Date <input type="date" name="date" required /></label>
        <fieldset>
          <legend>Override score</legend>
          <div class="gp-ovpick">{CLUSTERS.map((c) => <label><input type="radio" name="cluster" value={c} required /> <span>{c}</span></label>)}</div>
        </fieldset>
        <label>Notes on override score
          <textarea name="note" rows="4" required placeholder="What did you learn, and why does the score miss it?"></textarea>
          <small>Your notes and findings will be used to improve the model.</small>
        </label>
        <button type="submit" class="gp-ovsubmit">Submit override</button>
        <p class="gp-ovmsg" role="status"></p>
      </form>
      <h3 class="gp-ovtl-head">Previous override entries · <span data-ov-acct>Stripe</span></h3>
      <ol class="gp-ovtl" aria-live="polite"></ol>
      <button type="button" class="gp-ovclear">Clear my demo entries</button>
    </section>
  </div>

  <div class="gp-row gp-r4">
  <section class="gp-built" id="how-its-built">
    <h2>How it's built</h2>
    <p class="gp-prose">
      The account data lives in a single wide Postgres table on <a href="https://supabase.com">Supabase</a>. A SQL scoring function bands each field golf-style, rolls the bands into weighted bucket scores, and the page assigns P1 to P4 by splitting the book at the median on two axes: growth potential (the A-GPS score with ARR taken out) and spend (ARR). A separate WATCH floor flags NRR under 90 percent or a growth score worse than 6.0. This page reads a display-only view at build time with supabase-js, and row-level security keeps the raw inputs and notes private.
    </p>
    <details class="gp-more gp-model">
      <summary class="cta">
        <span class="gp-more-closed">Full data model</span>
        <span class="gp-more-open">Hide the field list</span>
      </summary>
      <dl class="gp-fields">
        <div>
          <dt>GTM</dt>
          <dd>NRR, ARR, NBEC, attach rate, attach dollars, percent of opportunities closed won, account team activity and notes.</dd>
        </div>
        <div>
          <dt>Marketing and programmatic</dt>
          <dd>Event, conference, and webinar attendance, webinar NPS, newsletter subscribed and opens, advocate or champion, success story published.</dd>
        </div>
        <div>
          <dt>Post-sales</dt>
          <dd>Premium success or SLA plan, CSQLs generated, CSQL win rate, onboarding delivered, onboarding completed, adoption achieved, value realized, CSM pulse RAG, CSM engaged and activity notes, support case count, SLA breaches, average days to resolve, professional services hours purchased and used.</dd>
        </div>
        <div>
          <dt>Product</dt>
          <dd>Feature requests.</dd>
        </div>
        <div>
          <dt>Down and distance</dt>
          <dd>Time to next renewal, key stakeholder alignment, years as a customer, 10-K signal, customer sentiment.</dd>
        </div>
      </dl>
    </details>
  </section>
    <section class="gp-soon" aria-labelledby="gp-soon-heading">
      <p class="gp-label">Roadmap</p>
      <h2 id="gp-soon-heading">Not in this scoring run</h2>
      <article>
        <p class="gp-soon-flag">Coming soon</p>
        <h3>Accounts moving MoM</h3>
        <p>Month-over-month cluster changes need a second score snapshot. This view has one scoring run, so nothing has moved yet.</p>
      </article>
      <article>
        <p class="gp-soon-flag">Coming soon</p>
        <h3>Saved overrides that feed the model</h3>
        <p>Overrides above are a browser-only demo. Next step: store them in a private table, show the real 90-day window, and use the notes to retune weights.</p>
      </article>
    </section>
  </div>
</div>

<script define:vars={{ seeds: DEMO_OVERRIDES }}>
  window.__gpSeeds = seeds;
</script>

<script>
  const root = document.getElementById("growth-propensity");
  if (root) {
    const tbody = root.querySelector("tbody");
    const search = root.querySelector<HTMLInputElement>(".gp-search");
    const shown = root.querySelector("#gp-shown");
    const panel = root.querySelector<HTMLElement>("#gp-detail");
    let sortKey = "overall";
    let dir = 1;
    let filter = "All";

    const numericKeys = new Set([
      "arr",
      "nrr",
      "renewal",
      "gtm",
      "mkt",
      "post",
      "prod",
      "dd",
      "overall",
    ]);

    function defaultDir(key: string) {
      return key === "arr" || key === "nrr" ? -1 : 1;
    }

    function showAccount(name: string, shouldScroll: boolean) {
      root.querySelectorAll<HTMLElement>("[data-detail]").forEach((article) => {
        article.hidden = article.getAttribute("data-detail") !== name;
      });
      root.querySelectorAll<HTMLElement>("[data-account]").forEach((control) => {
        if (control.getAttribute("data-account") === name) control.setAttribute("aria-current", "true");
        else control.removeAttribute("aria-current");
      });
      if (!shouldScroll || !panel) return;
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      panel.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "nearest" });
      const heading = panel.querySelector<HTMLElement>("[data-detail]:not([hidden]) h2");
      heading?.focus({ preventScroll: true });
    }

    function applyFilter() {
      if (!tbody) return;
      const query = search?.value.trim().toLowerCase() ?? "";
      let count = 0;
      tbody.querySelectorAll<HTMLTableRowElement>("tr[data-name]").forEach((row) => {
        const name = (row.dataset.name ?? "").toLowerCase();
        const cluster = row.dataset.cluster ?? "";
        const match = (filter === "All" || cluster === filter) && name.includes(query);
        row.hidden = !match;
        if (match) count += 1;
      });
      const empty = tbody.querySelector<HTMLTableRowElement>("tr.gp-empty");
      if (empty) empty.hidden = count !== 0;
      if (shown) shown.textContent = String(count);
    }

    function applySort(key: string) {
      if (!tbody) return;
      if (key === sortKey) dir *= -1;
      else {
        sortKey = key;
        dir = defaultDir(key);
      }
      const rows = [...tbody.querySelectorAll<HTMLTableRowElement>("tr[data-name]")];
      const indexed = rows.map((row, index) => ({ row, index }));
      indexed.sort((a, b) => {
        const av = a.row.dataset[sortKey] ?? "";
        const bv = b.row.dataset[sortKey] ?? "";
        let cmp = numericKeys.has(sortKey) ? Number(av) - Number(bv) : av.localeCompare(bv);
        if (cmp === 0) cmp = (a.row.dataset.name ?? "").localeCompare(b.row.dataset.name ?? "");
        if (cmp === 0) cmp = a.index - b.index;
        return cmp * dir;
      });
      const empty = tbody.querySelector("tr.gp-empty");
      indexed.forEach((item) => tbody.appendChild(item.row));
      if (empty) tbody.appendChild(empty);
      root.querySelectorAll<HTMLTableCellElement>(".gp-table th").forEach((th) => {
        th.setAttribute(
          "aria-sort",
          th.dataset.k === sortKey ? (dir === 1 ? "ascending" : "descending") : "none",
        );
      });
    }

    root.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const control = target.closest<HTMLElement>("[data-account]");
      if (!control || !root.contains(control)) return;
      const name = control.getAttribute("data-account");
      if (name) showAccount(name, true);
    });

    document.addEventListener("gp:select", (event) => {
      const d = (event as CustomEvent<{ name?: string; scroll?: boolean }>).detail;
      if (d?.name) showAccount(d.name, !!d.scroll);
    });

    // ---- Overrides (DEMO: seeds are invented; new entries live in localStorage only) ----
    type Ov = { account: string; date: string; cluster: string; reason: string; note: string; demo?: boolean };
    const KEY = "agps-demo-overrides";
    const seeds: Ov[] = (window as unknown as { __gpSeeds?: Ov[] }).__gpSeeds ?? [];
    const esc = (t: string) => t.replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);
    const local = (): Ov[] => {
      try { return JSON.parse(localStorage.getItem(KEY) ?? "[]"); } catch { return []; }
    };
    const all = () => [...seeds, ...local()].sort((x, y) => y.date.localeCompare(x.date));
    const today = () => {
      const n = new Date();
      return `${n.getFullYear()}-${String(n.getMonth() + 1).padStart(2, "0")}-${String(n.getDate()).padStart(2, "0")}`;
    };
    const within90 = (date: string) => (Date.now() - new Date(`${date}T12:00:00`).getTime()) / 864e5 <= 90;
    const fmt = (date: string) => new Date(`${date}T12:00:00`).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });

    function renderCells() {
      const list = all();
      root.querySelectorAll<HTMLElement>("[data-ov-cell]").forEach((cell) => {
        const name = cell.dataset.ovCell ?? "";
        const o = list.find((x) => x.account === name && within90(x.date));
        if (!o) { cell.innerHTML = ""; return; }
        const id = `ov-${name.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
        cell.innerHTML = `<button type="button" class="gp-ov gp-badge gp-${o.cluster}" aria-describedby="${id}">${o.cluster}<span class="gp-ov-tip" role="tooltip" id="${id}"><b>${fmt(o.date)} · Overridden to ${o.cluster} <i>${o.demo ? "Demo" : "Your entry"}</i></b><span>Reason: ${esc(o.reason)}</span><span>${esc(o.note)}</span></span></button>`;
      });
    }

    const form = root.querySelector<HTMLFormElement>(".gp-ovform");
    const tl = root.querySelector<HTMLElement>(".gp-ovtl");
    const acctLabel = root.querySelector<HTMLElement>("[data-ov-acct]");
    const msg = root.querySelector<HTMLElement>(".gp-ovmsg");
    function renderTimeline() {
      if (!form || !tl) return;
      const name = (form.elements.namedItem("account") as HTMLSelectElement).value;
      if (acctLabel) acctLabel.textContent = name;
      const items = all().filter((o) => o.account === name);
      tl.innerHTML = items.length
        ? items.map((o) => `<li><p class="gp-ovtl-top"><span class="gp-badge gp-${o.cluster}">${o.cluster}</span><b>${fmt(o.date)}</b><i>${o.demo ? "Demo" : "Your entry · this browser"}</i></p><p>${o.reason ? `<strong>${esc(o.reason)}.</strong> ` : ""}${esc(o.note)}</p></li>`).join("")
        : `<li class="gp-ovtl-empty">No overrides on file for ${esc(name)}.</li>`;
    }
    if (form) {
      const date = form.elements.namedItem("date") as HTMLInputElement;
      date.value = today();
      date.max = today();
      form.elements.namedItem("account")?.addEventListener("change", renderTimeline);
      form.addEventListener("submit", (event) => {
        event.preventDefault();
        const f = new FormData(form);
        const note = String(f.get("note") ?? "").trim();
        const entry: Ov = {
          account: String(f.get("account")),
          date: String(f.get("date")),
          cluster: String(f.get("cluster")),
          reason: note.split(/[.!?\n]/)[0].slice(0, 60),
          note,
        };
        try {
          localStorage.setItem(KEY, JSON.stringify([...local(), entry]));
          if (msg) msg.textContent = `Saved in this browser: ${entry.account} → ${entry.cluster}.`;
        } catch {
          if (msg) msg.textContent = "This browser blocked local storage, so the entry was not saved.";
        }
        (form.elements.namedItem("note") as HTMLTextAreaElement).value = "";
        renderTimeline();
        renderCells();
      });
    }
    root.querySelector(".gp-ovclear")?.addEventListener("click", () => {
      localStorage.removeItem(KEY);
      if (msg) msg.textContent = "Your demo entries were cleared. The invented examples stay.";
      renderTimeline();
      renderCells();
    });
    renderCells();
    renderTimeline();

    const float = document.createElement("div");
    float.className = "gp-ovfloat";
    float.hidden = true;
    document.body.appendChild(float);
    const showTip = (chip: Element) => {
      const tip = chip.querySelector(".gp-ov-tip");
      if (!tip) return;
      float.innerHTML = tip.innerHTML;
      float.hidden = false;
      const r = chip.getBoundingClientRect();
      const w = float.offsetWidth, h = float.offsetHeight;
      let x = r.right - w, y = r.top - h - 8;
      if (y < 8) y = r.bottom + 8;
      x = Math.max(8, Math.min(window.innerWidth - w - 8, x));
      float.style.left = `${x}px`;
      float.style.top = `${y}px`;
    };
    const hideTip = () => { float.hidden = true; };
    root.addEventListener("mouseover", (e) => { const c = (e.target as Element).closest?.(".gp-ov"); if (c) showTip(c); });
    root.addEventListener("mouseout", (e) => { if ((e.target as Element).closest?.(".gp-ov")) hideTip(); });
    root.addEventListener("focusin", (e) => { const c = (e.target as Element).closest?.(".gp-ov"); if (c) showTip(c); });
    root.addEventListener("focusout", hideTip);
    window.addEventListener("scroll", hideTip, { passive: true });

    root.querySelectorAll<HTMLButtonElement>(".gp-chip").forEach((chip) => {
      chip.addEventListener("click", () => {
        filter = chip.dataset.filter ?? "All";
        root.querySelectorAll(".gp-chip").forEach((item) => {
          item.setAttribute("aria-pressed", item === chip ? "true" : "false");
        });
        applyFilter();
      });
    });

    root.querySelectorAll<HTMLButtonElement>(".gp-table th button").forEach((button) => {
      button.addEventListener("click", () => {
        const key = button.closest("th")?.dataset.k;
        if (key) applySort(key);
      });
    });

    search?.addEventListener("input", applyFilter);
  }
</script>

