---
interface Props {
  src?: string;
  alt?: string;
  credit?: string;
  side?: "left" | "right";
}

const { src, alt = "", credit, side = "left" } = Astro.props;
---

<figure class:list={["split-figure", side === "right" && "split-figure-right"]}>
  <div class="split-media">
    <div class="split-image">
      {
        src ? (
          <img src={src} alt={alt} loading="lazy" />
        ) : (
          <div class="split-placeholder" aria-hidden="true"></div>
        )
      }
    </div>
    {credit && <p class="split-credit">{credit}</p>}
  </div>
  <figcaption class="split-copy">
    <div class="split-copy-body">
      <slot />
    </div>
  </figcaption>
</figure>

<style>
  .split-figure {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas: "image copy";
    gap: 2.5rem 3rem;
    align-items: center;
    margin: 3rem 0;
  }

  .split-figure-right {
    grid-template-areas: "copy image";
  }

  .split-media {
    grid-area: image;
  }

  .split-image {
    overflow: hidden;
    background: var(--bg-soft);
  }

  .split-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .split-placeholder {
    width: 100%;
    height: 100%;
    background: var(--bg-soft);
  }

  .split-copy {
    grid-area: copy;
    margin: 0;
  }

  .split-copy-body {
    color: var(--text);
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .split-copy-body :global(p) {
    margin: 0 0 1.25rem;
  }

  .split-copy-body :global(p:last-child) {
    margin-bottom: 0;
  }

  .split-credit {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0.75rem 0 0;
  }

  @media (max-width: 800px) {
    .split-figure,
    .split-figure-right {
      grid-template-columns: 1fr;
      grid-template-areas:
        "image"
        "copy";
      gap: 1.5rem;
    }

    .split-image img {
      width: 100%;
      height: auto;
    }
  }
</style>
