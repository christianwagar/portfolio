---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { influences, site } from "../../data/site";

type Book = (typeof influences.books)[number];

export async function getStaticPaths() {
  const reviews = await getCollection("books");
  const booksBySlug = new Map(
    influences.books
      .filter((book): book is Book & { slug: string } => typeof book.slug === "string")
      .map((book) => [book.slug, book]),
  );

  return reviews.flatMap((review) => {
    const book = booksBySlug.get(review.id);
    if (!book) return [];
    return [{ params: { slug: review.id }, props: { book, review } }];
  });
}

interface Props {
  book: Book & { slug: string };
  review: CollectionEntry<"books">;
}

const { book, review } = Astro.props;
const { Content } = await render(review);
const pageTitle = `${book.title} — ${site.name}`;
---

<Layout title={pageTitle} description={book.note}>
  <Nav />
  <main>
    <article class="section review-section">
      <div class="container review-inner">
        <a href="/#influences" class="review-back">Books</a>
        <p class="review-status">{book.status}</p>
        <h1 class="review-title">{book.title}</h1>
        <p class="review-author">{book.author}</p>
        {book.link && (
          <a
            href={book.link}
            class="cta review-amazon"
            target="_blank"
            rel="noopener noreferrer"
          >
            Amazon
          </a>
        )}
        <div class="review-body">
          <Content />
        </div>
      </div>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .review-section {
    background: var(--bg);
  }

  .review-inner {
    max-width: 42rem;
  }

  .review-back {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 2rem;
  }

  .review-status {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 0.375rem;
  }

  .review-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.1;
    margin: 0 0 0.5rem;
  }

  .review-author {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 1.25rem;
  }

  .review-amazon {
    display: inline-block;
    margin-bottom: 2rem;
  }

  .review-body {
    color: var(--text-muted);
    font-size: 1.0625rem;
    line-height: 1.75;
    max-width: 65ch;
  }

  .review-body :first-child {
    margin-top: 0;
  }

  .review-body p {
    margin: 0 0 1.25rem;
  }

  .review-body p:last-child {
    margin-bottom: 0;
  }

  .review-body a {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
</style>
