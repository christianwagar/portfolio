---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { influences, site } from "../../data/site";

type Book = (typeof influences.books)[number];

export async function getStaticPaths() {
  const reviews = await getCollection("books");
  const booksBySlug = new Map(
    influences.books
      .filter((book): book is Book & { slug: string } => typeof book.slug === "string")
      .map((book) => [book.slug, book]),
  );

  return reviews.flatMap((review) => {
    const book = booksBySlug.get(review.id);
    if (!book) return [];
    return [{ params: { slug: review.id }, props: { book, review } }];
  });
}

interface Props {
  book: Book & { slug: string };
  review: CollectionEntry<"books">;
}

const { book, review } = Astro.props;
const { Content } = await render(review);
const pageTitle = `${book.title} — ${site.name}`;
---

<Layout title={pageTitle} description={book.note}>
  <Nav />
  <main>
    <article class="section review-section">
      {
        book.image && (
          <div class="review-hero">
            <img src={book.image} alt={book.imageAlt ?? book.title} />
          </div>
        )
      }
      <div class="container review-inner">
        <a href="/#influences" class="review-back">Books</a>
        <header class="review-header">
          <h1 class="review-title">{book.title}</h1>
          {book.link && (
            <a
              href={book.link}
              class="cta review-order"
              target="_blank"
              rel="noopener noreferrer"
            >
              Where to McOrder this
            </a>
          )}
          {book.date && <p class="review-date">{book.date}</p>}
        </header>
        <div class="review-body">
          <Content />
        </div>
      </div>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .review-section {
    background: var(--bg);
    padding-top: 0;
    border-top: none;
  }

  .review-section:not(:has(.review-hero)) {
    padding-top: 5.5rem;
  }

  .review-hero {
    margin: 0 0 2.75rem;
  }

  .review-hero img {
    width: 100%;
    height: auto;
  }

  .review-inner {
    max-width: 40rem;
    margin-inline: auto;
  }

  .review-header {
    margin-bottom: 2rem;
  }

  .review-back {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 2rem;
  }

  .review-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.1;
    margin: 0 0 0.75rem;
  }

  .review-order {
    display: inline-block;
  }

  .review-date {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0.75rem 0 0;
  }

  .review-body {
    color: var(--text);
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .review-body :global(> :first-child) {
    margin-top: 0;
  }

  .review-body :global(p) {
    margin: 0 0 1.25rem;
  }

  .review-body :global(p:last-child) {
    margin-bottom: 0;
  }

  .review-body :global(a) {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .review-body :global(h2),
  .review-body :global(h3) {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text);
    line-height: 1.2;
  }

  .review-body :global(h2) {
    font-size: 1.375rem;
    margin: 2.5rem 0 1rem;
  }

  .review-body :global(h3) {
    font-size: 1.125rem;
    margin: 2rem 0 0.75rem;
  }
</style>
