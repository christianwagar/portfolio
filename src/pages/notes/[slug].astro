---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { site } from "../../data/site";

export async function getStaticPaths() {
  const notes = (await getCollection("notes")).filter((note) => !note.data.hidden);
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

interface Props {
  note: CollectionEntry<"notes">;
}

const { note } = Astro.props;
const { Content } = await render(note);
const { title, teaser, status, image, imageAlt } = note.data;
const pageTitle = `${title} — ${site.name}`;
---

<Layout title={pageTitle} description={teaser}>
  <Nav />
  <main>
    <article class="section note-section">
      <div class="container">
        <a href="/#notes" class="note-back">Field notes</a>

        {
          image && (
            <div class="note-hero">
              <img src={image} alt={imageAlt ?? title} />
            </div>
          )
        }

        <header class="note-header">
          <p class="note-status">{status}</p>
          <h1 class="note-title">{title}</h1>
        </header>

        <div class="note-body">
          <Content />
        </div>
      </div>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .note-section {
    background: var(--bg);
  }

  .note-back {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 2rem;
  }

  .note-hero {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--bg-soft);
    margin: 0 0 2.75rem;
  }

  .note-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .note-header {
    max-width: 42rem;
    margin-bottom: 2rem;
  }

  .note-status {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 0.375rem;
  }

  .note-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.1;
    margin: 0;
  }

  .note-body {
    color: var(--text);
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .note-body :global(> p),
  .note-body :global(> h2),
  .note-body :global(> h3),
  .note-body :global(> ul),
  .note-body :global(> ol),
  .note-body :global(> blockquote) {
    max-width: 65ch;
  }

  .note-body :global(> :first-child) {
    margin-top: 0;
  }

  .note-body :global(p) {
    margin: 0 0 1.25rem;
  }

  .note-body :global(p:last-child) {
    margin-bottom: 0;
  }

  .note-body :global(a) {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .note-body :global(h2),
  .note-body :global(h3) {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text);
    line-height: 1.2;
  }

  .note-body :global(h2) {
    font-size: 1.375rem;
    margin: 2.5rem 0 1rem;
  }

  .note-body :global(h3) {
    font-size: 1.125rem;
    margin: 2rem 0 0.75rem;
  }

  .note-body :global(.split-figure) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas: "image copy";
    gap: 2.5rem 3rem;
    align-items: center;
    margin: 3rem 0;
    max-width: none;
  }

  .note-body :global(.split-figure-right) {
    grid-template-areas: "copy image";
  }

  .note-body :global(.split-media) {
    grid-area: image;
  }

  .note-body :global(.split-image) {
    overflow: hidden;
    background: var(--bg-soft);
  }

  .note-body :global(.split-image img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .note-body :global(.split-placeholder) {
    width: 100%;
    min-height: 12rem;
    background: var(--bg-soft);
  }

  .note-body :global(.split-copy) {
    grid-area: copy;
    margin: 0;
  }

  .note-body :global(.split-copy-body) {
    color: var(--text);
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .note-body :global(.split-copy-body p) {
    margin: 0 0 1.25rem;
  }

  .note-body :global(.split-copy-body p:last-child) {
    margin-bottom: 0;
  }

  .note-body :global(.split-credit) {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0.75rem 0 0;
  }

  @media (max-width: 800px) {
    .note-body :global(.split-figure),
    .note-body :global(.split-figure-right) {
      grid-template-columns: 1fr;
      grid-template-areas:
        "image"
        "copy";
      gap: 1.5rem;
    }
  }
</style>
